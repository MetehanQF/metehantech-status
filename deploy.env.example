# deploy.env.example — deployment'a ozel yollar ve hesaplar
#
# Uretimdeki gercek dosya:  /etc/metehantech-status/deploy.env  (root:root 0600)
# systemd drop-in'i su satirla yukler:
#   EnvironmentFile=-/etc/metehantech-status/deploy.env
#
# Bu dosya SADECE ornektir; gercek makine yolu ICERMEZ.
#
# Projenin KENDI dosyalari burada tanimlanmaz — onlar modulun konumundan
# turetilir (deployment.PROJECT_ROOT / DATA_DIR). Repoyu nereye klonlarsaniz
# dogru calisir. Burada yalnizca TAHMIN EDILEMEYECEK degerler bulunur.
#
# Kurulum:
#   cp deploy.env.example deploy/deploy.env    # deploy/deploy.env Git disidir
#   chmod 600 deploy/deploy.env && nano deploy/deploy.env
#   sudo bash deploy/install-network-env.sh    # network.env ile birlikte kurar

# ═════════════════════════════════════════════
# ZORUNLU — yedekleme
# Eksikse servis yanlis bir hedefe baglanmak yerine DeploymentConfigError verir.
# ═════════════════════════════════════════════

# Uzak yedek hedefindeki hesap adi.
BACKUP_REMOTE_USER=backupuser

# Yalnizca yedekleme icin kullanilan SSH ozel anahtari.
# Bu anahtar repo disinda durur ve asla commit edilmez.
BACKUP_SSH_KEY=/home/youruser/.ssh/backup_ed25519

# ═════════════════════════════════════════════
# ZORUNLU — DNS Center
# ═════════════════════════════════════════════

# AdGuard Home yonetici kimlik bilgisi dosyasi (JSON).
DNS_CREDENTIALS=/etc/metehantech-dns/credentials.json

# ═════════════════════════════════════════════
# OPSIYONEL — tanimsizsa ilgili ozellik ACIKCA devre disi kalir
# ═════════════════════════════════════════════

# Yedege dahil edilecek ek kardes proje dizinleri (PATH gibi iki nokta ile ayrilmis).
# BACKUP_EXTRA_SOURCES=/home/youruser/project-two:/home/youruser/project-three

# OpenClaw calisma alani; icerigi taranip secret tasiyan dosyalar dislanarak
# yedege eklenir. Tanimsizsa takviye adimi atlanir.
# OPENCLAW_WORKSPACE=/home/youruser/.openclaw/workspace

# Yerel Home Assistant koprusunun urettigi durum dosyasi (Camera Center kullanir).
# HA_RUNTIME_STATUS=/home/youruser/homeassistant/config/runtime/status.json

# Geri yukleme tatbikati ciktisi (Backup Center dogrulamasinda referans alinir).
# RESTORE_ATTESTATION=/home/youruser/restore-results.json
