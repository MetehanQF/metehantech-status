# admin.env.example — metehantech_status ortam degiskenleri
#
# Uretimdeki gercek dosya:  /etc/metehantech-status/admin.env  (root:root 0600)
# systemd bunu su satirla yukler:
#   EnvironmentFile=-/etc/metehantech-status/admin.env
#
# Bu dosya SADECE ornektir; gercek deger ICERMEZ ve icermemelidir.
# Kopyalayip doldurmak icin:
#   sudo install -m 600 -o root -g root admin.env.example /etc/metehantech-status/admin.env
#   sudo nano /etc/metehantech-status/admin.env
#   sudo systemctl restart --no-block metehantech-status.service
#
# UYARI: bu servisi ASLA SIGHUP/reload ile yenilemeyin. history.start_collector()
# flock'u yalnizca bir kez dener; reload sirasinda collector tamamen kaybolur.
# Daima "systemctl restart --no-block" kullanin.

# ═════════════════════════════════════════════
# ZORUNLU — admin paneli kimlik dogrulama
# ═════════════════════════════════════════════

# werkzeug ile uretin, duz parola YAZMAYIN:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
ADMIN_PASSWORD_HASH=scrypt:replace-with-werkzeug-generated-hash

# En az 32 rastgele bayt:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Bos birakilirsa her yeniden baslatmada rastgele uretilir => oturumlar duser.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# ═════════════════════════════════════════════
# OPSIYONEL — admin davranisi
# ═════════════════════════════════════════════

# Uretimde 1 kalmali. Yalnizca yerel HTTP testinde 0 yapin.
ADMIN_COOKIE_SECURE=1

# Docker kontrollerine izin verilen TAM container adlari (virgullu).
# Bos birakmak Docker kontrollerini tamamen kapatir (guvenli varsayilan).
ADMIN_DOCKER_CONTAINERS=

# Alert Center uyarilari yerel olarak kaydeder; 1 yapilmadikca Telegram gondermez.
ALERT_TELEGRAM_ENABLED=0

# ═════════════════════════════════════════════
# OPSIYONEL — veritabani yollari
# Hepsinin makul varsayilani var; yalnizca test/alternatif konum icin ayarlayin.
# Varsayilan kok: <proje>/data/
# ═════════════════════════════════════════════

# ALERTS_DB=<PROJECT_ROOT>/data/alerts.db
# BACKUPS_DB=<PROJECT_ROOT>/data/backups.db
# ADMIN_ACTIVITY_DB=<PROJECT_ROOT>/data/admin_activity.db

# ═════════════════════════════════════════════
# OPSIYONEL — yedekleme motoru (Pi5 tarafi)
# ═════════════════════════════════════════════

# BACKUP_WORK_ROOT=<PROJECT_ROOT>/data/backup-work
# BACKUP_LOCK_PATH=<PROJECT_ROOT>/data/backup.lock
# BACKUP_PI_DESTINATION=/srv/metehantech-backups/from-pcold

# ═════════════════════════════════════════════
# OPSIYONEL — PcOld tarafi (backup/pcold_*.py)
# Bu degiskenler PcOld host'unda gecerlidir, Pi5'te degil.
# ═════════════════════════════════════════════

# PCOLD_BACKUP_STATE_ROOT=/var/lib/metehantech-backup
# PCOLD_BACKUP_USER=metehanbackup
# PCOLD_BACKUP_GROUP=metehanbackup
# PCOLD_BACKUP_EXPORT_OWNER=root
# PCOLD_PI_BACKUP_DESTINATION=/srv/metehantech-backups/from-pi
# PCOLD_WATCHDOG_DB=/var/lib/private/metehantech-watchdog/events.db
# PCOLD_UPTIME_ROOT=/var/lib/docker/volumes/uptime-kuma-data/_data
