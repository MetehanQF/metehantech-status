# network.env.example — ortam bagimli ag adresleri
#
# Uretimdeki gercek dosya:  /etc/metehantech-status/network.env  (root:root 0644)
# systemd drop-in'i su satirla yukler:
#   EnvironmentFile=-/etc/metehantech-status/network.env
#
# Bu dosya SADECE ornektir. Icindeki adresler RFC dokumantasyon bloklarindandir
# ve hicbir gercek cihaza isaret etmez:
#   192.0.2.0/24    RFC 5737  (TEST-NET-1, dokumantasyon)
#   100.64.0.0/10   RFC 6598  (CGNAT araligi; Tailscale de bu araligi kullanir)
#
# Kurulum:
#   cp network.env.example deploy/network.env     # deploy/network.env Git disidir
#   chmod 600 deploy/network.env && nano deploy/network.env
#   sudo bash deploy/install-network-env.sh       # kaynagi deploy/network.env'den okur
#
# Kurulum betigi gercek deger ICERMEZ; onlari yukaridaki Git disi dosyadan alir.
# Kaynak kodda gercek adres fallback'i YOKTUR; bir deger eksikse servis
# yanlis hedefe baglanmak yerine acik hata verir (network.NetworkConfigError).

# ═════════════════════════════════════════════
# ZORUNLU — LAN adresleri
# ═════════════════════════════════════════════

# Pi5 (birincil host: Control Center, HA, AdGuard, Frigate, Nextcloud)
PI5_LAN_IP=192.0.2.20

# PcOld (NFS kamera deposu, yedek hedefi, ikincil AdGuard, Uptime Kuma, watchdog)
PCOLD_LAN_IP=192.0.2.22

# IP kamera (Frigate kaynagi)
CAMERA_LAN_IP=192.0.2.110

# ═════════════════════════════════════════════
# ZORUNLU — Tailscale adresleri
# ═════════════════════════════════════════════

PI5_TAILSCALE_IP=100.64.0.10
PCOLD_TAILSCALE_IP=100.64.0.11

# ═════════════════════════════════════════════
# OPSIYONEL — ag gecidi ve arayuz
# Yalnizca ag degistirme betigi (net-switch-usb-only.sh) kullanir.
# ═════════════════════════════════════════════

# Varsayilan ag gecidi / router
ROUTER_LAN_IP=192.0.2.1

# USB WiFi dongle arayuz adi.
# DIKKAT: gercek sistemde bu ad "wlx<mac>" bicimindedir ve donaniminin
# MAC adresini icerir. Bu yuzden repoya girmez.
PI5_WIFI_IFACE=wlan-example

# Dahili (onboard) WiFi'in NetworkManager baglanti adi.
# Betik bunu devre disi birakip yalnizca USB dongle'i birakir.
ONBOARD_CONN=example-onboard-wifi
