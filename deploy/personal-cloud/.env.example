# .env.example — personal-cloud (Nextcloud + Postgres + Redis)
#
# Gercek dosya: bu dizindeki .env  (ve /opt/metehantech-cloud/.env — ikisi ayni)
# Bu dosya yalnizca IMAJ PIN'leri tutar. Parola ICERMEZ.
#
# Parolalar compose.yaml icinde Docker secrets ile okunur:
#   POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# Secret dosyalari repo disindadir: /etc/metehantech-cloud/secrets/
# Ayrinti icin secrets.example.md dosyasina bakin.
#
# Kullanim:  cp .env.example .env    (pin'ler asagidakilerle ayni kalabilir)

# ═════════════════════════════════════════════
# IMAJ PIN'LERI
# Digest'e pinlemek kontrolsuz upstream degisimini engeller.
# Etiket (":stable" gibi) KULLANMAYIN — sessizce degisir.
# Guncel digest'i almak icin:  docker buildx imagetools inspect nextcloud:31-apache
# ═════════════════════════════════════════════

NEXTCLOUD_IMAGE=nextcloud@sha256:REPLACE_WITH_PINNED_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_PINNED_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_PINNED_DIGEST
