# network.env.example — PcOld watchdog ag adresleri
#
# Gercek dosya, PcOld uzerinde:  /etc/metehantech-watchdog/network.env
#                                (root:root 0600)
# Birim onu su satirla yukler:
#   EnvironmentFile=-/etc/metehantech-watchdog/network.env
#
# Buradaki adresler RFC 5737 dokumantasyon blogundandir; gercek cihaza
# isaret etmez ve oldugu gibi kullanilmamalidir.

# Watchdog'un erisilebilirligini yokladigi Pi'nin LAN adresi
PI5_LAN_IP=192.0.2.20

# Watchdog'un HTTP arayuzunu (8766) baglayacagi yerel LAN adresi
PCOLD_LAN_IP=192.0.2.22
